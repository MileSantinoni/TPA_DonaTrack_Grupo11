# Copiar como .env. No subir .env a GitHub.
# Para AWS:
# PUBLIC_HOST=donatrack.tu-dominio.com
# PUBLIC_BASE_URL=https://donatrack.tu-dominio.com
# PUBLIC_BASE_URL no debe terminar con una barra.

PUBLIC_HOST=http://localhost
PUBLIC_BASE_URL=http://localhost

DONACIONES_DB_PASSWORD=
LOGISTICA_DB_PASSWORD=

# update para crear el esquema inicial.
# Después de inicializarlo, cambiar ambos a validate.
DONACIONES_DB_DDL=update
LOGISTICA_DB_DDL=update

LOGTO_ISSUER=
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=

PLANIFICACION_TOKEN=
AUSENCIAS_CRON_TOKEN=

HEIGIT_API_KEY=
GEOAPIFY_API_KEY=

DEPOSITO_DIRECCION=
DEPOSITO_LATITUD=
DEPOSITO_LONGITUD=

MAIL_USERNAME=
MAIL_PASSWORD=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_PHONE_NUMBER=

# Una máquina: dejar estas direcciones.
# Dos EC2: usaremos las IP privadas correspondientes.
LOGISTICA_URL=http://logistica:8082
DONACIONES_URL=http://donaciones:8083
LOGISTICA_UPSTREAM=logistica:8082

# En cada EC2 cambiaremos el bind de su servicio por su IP privada.
WEB_BIND_HOST=127.0.0.1
LOGISTICA_BIND_HOST=127.0.0.1