@startuml

' =========================================
' Diagrama de clases - DonaTrack
' =========================================

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

' -----------------------------------------
' 1. GESTIÓN DE DONANTES
' -----------------------------------------
package "Gestión de Donantes" {
    enum TipoOrganizacion {
        GUBERNAMENTAL
        ONG
        EMPRESA
        INSTITUCION
    }

    enum EstadoRegistro {
        PRIMER_ACCESO
        ACTIVO
    }

    enum TipoMedioContacto {
        TELEFONO
        WHATSAPP
    }

    enum TipoDocumento {
        DNI
        CUIT
    }

    enum Genero {
        MASCULINO
        FEMENINO
        OTRO
    }

    enum TipoContactoPredeterminado {
        MAIL
        TELEFONO
        WHATSAPP
    }

    class MedioContacto {
        -TipoMedioContacto tipo
        -String numero
        +getTipo(): TipoMedioContacto
        +getNumero(): String
    }

    abstract class Donante {
        #String id
        #String mail
        #EstadoRegistro estadoRegistro
        #List<MedioContacto> mediosDeContacto
        #TipoContactoPredeterminado contactoPredeterminado
        #String numeroDocumento
        #TipoDocumento tipoDeDocumento
        +activar()
        +agregarMedioContacto(medioContacto: MedioContacto)
        +actualizarDatos(mail: String, numeroDocumento: String, tipoDeDocumento: TipoDocumento)
        +definirContactoPredeterminado(contactoPredeterminado: TipoContactoPredeterminado)
    }

    class "Persona Humana" as PersonaHumana {
        -String nombre
        -String apellido
        -int edad
        -Genero genero
        -String direccion
    }

    class "Persona Juridica" as PersonaJuridica {
        -String razonSocial
        -TipoOrganizacion tipo
        -String rubro
        -List<Representante> representantes
        +agregarRepresentante(representante: Representante)
    }


    class ImportadorCSV {
        -RepositorioDonantes repositorio
        -int donantesCreados
        -int donantesActualizados
        +importar(rutaArchivo: String)
        +getDonantesCreados(): int
        +getDonantesActualizados(): int
    }
}

' -----------------------------------------
' 2. CATÁLOGO Y BIENES
' -----------------------------------------
package "Catálogo y Bienes" {


    enum Estado {
        NUEVO
        USADO
    }

    enum TipoAtributo {
            PERECEDERO
            CON_ESTADO
            NO_PERECEDERO
        }

    class Categoria {
        +String id
        +String nombre
    }

    class Subcategoria {
            -String id
            -String nombre
            -TipoAtributo tipo
            +Subcategoria(id: String, nombre: String, tipo: TipoAtributo)

        }

    class Bien {
        +String id
        +String descripcion
        +String foto
        +Int cantidad
        +String unidadMedida
        +Subcategoria subcategoria
        +LocalDate fechaVencimiento
        +Estado estado
    }
}

' -----------------------------------------
' 3. GESTIÓN DE DONACIONES
' -----------------------------------------
package "Gestión de Donaciones" {
    enum EstadoDonacion {
        EN_DEPOSITO
        ASIGNACION_REALIZADA
        LISTA_PARA_ENTREGAR
        EN_TRASLADO
        ENTREGADA
        ENTREGA_FALLIDA
        VENCIDA
    }

    enum UnidadMedida {
        UNIDAD
        KILOGRAMO
        LITRO
        PAQUETE
    }

    interface EstadoDonacionState {
            +getNombre(): EstadoDonacion
            +cambiarA(donacion: Donacion, nuevoEstado: EstadoDonacion, justificativo: String)
        }

        abstract class EstadoDonacionBase {
            #permitidos(estados: EstadoDonacion...): List<EstadoDonacion>
            #{abstract} getEstadosPermitidos(): List<EstadoDonacion>
        }

        note bottom of EstadoDonacionBase
          Existen 7 clases concretas que heredan de
          EstadoDonacionBase (ej: EstadoDonacionEnDeposito),
          una por cada valor del enum EstadoDonacion.
        end note

        class EstadoDonacionFactory {
            +{static} crear(estado: EstadoDonacion): EstadoDonacionState
        }

    class "Registro Donacion" as RegistroDonacion {
        -String id
        -String descripcionGeneral
        -Donante donante
        -LocalDate fechaDeRegistro
        -List<Bien> listaBienes
        +agregarBien(bien: Bien)
        +segmentar() : List<Donacion>
        +getDonante() : Donante
        +getFechaDeRegistro() : LocalDate
    }

    class Donacion {
        -String id
        -String descripcionGeneral
        -int cantidad
        -String unidadMedida
        -Subcategoria subcategoria
        -LocalDate fechaDeRegistro
        -LocalDate fechaVencimiento
        -Estado estadoBien
        -EstadoDonacionState estadoActual
        -List<RegistroCambioEstado> historialEstados
        -Donante donante
        +cambiarEstado(nuevoEstado: EstadoDonacion, justificativo: String)
        ~aplicarCambioEstado(nuevoEstado: EstadoDonacionState, justificativo: String)
        +getEstadoActual(): EstadoDonacion
        +getHistorialEstados(): List<RegistroCambioEstado>
    }

    class RegistroCambioEstado {
        -EstadoDonacion estadoAnterior
        -EstadoDonacion estadoNuevo
        -LocalDateTime fechaYHora
        -String justificativo
    }

    class AsignacionDonacion {
        -String id
        -Donacion donacion
        -EntidadBeneficiaria entidad
        -Necesidad necesidad
        -LocalDate fechaRecepcion
        +getId(): String
        +getDonacion(): Donacion
        +getEntidad(): EntidadBeneficiaria
        +getNecesidad(): Necesidad
        +getFechaRecepcion(): LocalDate
    }

}

' -----------------------------------------
' 4. ENTIDADES Y NECESIDADES
' -----------------------------------------
package "Entidades y Necesidades" {
    enum Periodicidad {
        SEMANAL
        ANUAL
        MENSUAL
    }

    class "EntidadBeneficiaria" as EntidadBeneficiaria {
        +String id
        +String razonSocial
        +String direccion
        +String telefono
        +List<Representante> representantes
        +List<Necesidad> necesidades
        +registrarNecesidades()
        +setRazonSocial(razonSocial: String)
        +setDireccion(direccion: String)
        +setTelefono(telefono: String)
    }

    abstract class "Necesidad" as Necesidad {
        +String id
        +String descripcion
        +Int cantidadObjetivo
        +Int cantidadCubierta
        +Subcategoria subcategoria
        +registrarDonacion()
        +estaSatisfecha()
    }

    class "Necesidad Recurrente" as NecesidadRecurrente {
        +Date fechaInicioPeriodo
        +Periodicidad periodicidad
    }

    class "Necesidad Extraordinaria" as NecesidadExtraordinaria {
        +String motivo
    }


    class Representante {
        -String nombre
        -String apellido
        -String email
    }
}

' -----------------------------------------
' 5. NOTIFICACIONES
' -----------------------------------------
package "Notificaciones" {
    enum EstadoNotificacion {
        PENDIENTE
        COMPLETADA
        FALLIDA
    }

    enum MedioNotificacion {
        EMAIL
        SMS
        WHATSAPP
    }

    class Notificacion {
        -String id
        -String destinatario
        -String mensaje
        -EstadoNotificacion estado
        -LocalDateTime fechaEnvio
        +marcarComoCompletada()
        +marcarComoFallida()
        +getDestinatario(): String
        +getMensaje(): String
        +getEstado(): EstadoNotificacion
    }

    class Notificador {
        -Map<TipoContactoPredeterminado, TipoNotificacion> estrategias
        +notificarDonante(donante: Donante, mensaje: String): Notificacion
        +notificarPorEmail(destinatario: String, mensaje: String): Notificacion
        -resolverDestinatario(donante: Donante): String
        -buscarNumero(medios: List<MedioContacto>, tipoMedio: TipoMedioContacto): String
    }

    interface TipoNotificacion {
        +enviar(destinatario: String, mensaje: String): Notificacion
    }

    class Email {
        +enviar(destinatario: String, mensaje: String): Notificacion
    }

    class SMS {
        -String remitente
        +enviar(destinatario: String, mensaje: String): Notificacion
    }

    class WhatsApp {
        -String remitente
        +enviar(destinatario: String, mensaje: String): Notificacion
    }
}

' -----------------------------------------
' 6. LOGÍSTICA Y ENTREGAS
' -----------------------------------------
package "Logística y Entregas" {
    enum EstadoEntrega {
        PENDIENTE
        EN_TRASLADO
        ENTREGADA
        NO_RECIBIDA
    }

    class Camion {
        -String patente
        -double capacidadVolumen
        -double altura
        -double capacidadCarga
        -UbicacionCamion ultimaUbicacion
        +actualizarUbicacion(ubicacion: UbicacionCamion)
        +getPatente(): String
        +getUltimaUbicacion(): UbicacionCamion
    }

    class Ruta {
        -Camion camion
        -List<Entrega> entregas
        -boolean activa
        +agregarEntrega(entrega: Entrega)
        +iniciar()
        +cantidadEntregas(): int
        +cantidadEntregadas(): int
        +porcentajeAvance(): double
        +estaActiva(): boolean
    }

    class Entrega {
        -Donacion donacion
        -EntidadBeneficiaria destino
        -Camion camionResponsable
        -int orden
        -EstadoEntrega estado
        -List<String> fotosRecepcion
        +marcarEnTraslado()
        +marcarEntregada(camion: Camion)
        +marcarNoRecibida()
        +volverAPendiente()
        +agregarFotoRecepcion(fotoUrl: String)
        +fueResuelta(): boolean
    }

    class UbicacionCamion {
        -double latitud
        -double longitud
        -double velocidad
        -LocalDateTime fechaYHora
        +getLatitud(): double
        +getLongitud(): double
        +getVelocidad(): double
        +getFechaYHora(): LocalDateTime
    }

    class ReporteUbicacion {
        -String patente
        -double latitud
        -double longitud
        -double velocidad
        -LocalDateTime fechaYHora
        +getPatente(): String
    }

    class MonitorCamiones {
        -List<Ruta> rutasEnSeguimiento
        +registrarRuta(ruta: Ruta)
        +recibirReporte(reporte: ReporteUbicacion): boolean
        +ubicacionActual(patente: String): UbicacionCamion
        +avanceDeRuta(patente: String): double
        +rutaDe(patente: String): Ruta
        -buscarRutaPorPatente(patente: String): Ruta
        -coordenadasValidas(reporte: ReporteUbicacion): boolean
        -esReporteAtrasado(camion: Camion, reporte: ReporteUbicacion): boolean
    }
}


' -----------------------------------------
' 9. ALGORITMOS DE ASIGNACIÓN
' -----------------------------------------


package "Algoritmos de Asignación" {

    class AlgoritmoMadre {
        -algoritmoCompatibilidadSemantica: AlgoritmoCompatibilidadSemantica
        -algoritmoPrioridadSubAtendidos: AlgoritmoPrioridadSubAtendidos
        +proponer(donacion: Donacion, entidades: List<EntidadBeneficiaria>): List<EntidadBeneficiaria>
    }

    class AlgoritmoCompatibilidadSemantica {
        +proponer(candidaturas: List<CandidaturaBeneficiaria>): List<CandidaturaBeneficiaria>
    }

    class AlgoritmoPrioridadSubAtendidos {
        -repositorioAsignaciones: RepositorioAsignacionesDonacion
        +proponer(candidaturas: List<CandidaturaBeneficiaria>): List<CandidaturaBeneficiaria>
    }

    class CandidaturaBeneficiaria {
        -donacion: Donacion
        -entidad: EntidadBeneficiaria
        -necesidad: Necesidad
        +getDonacion(): Donacion
        +getEntidad(): EntidadBeneficiaria
        +getNecesidad(): Necesidad
    }

    class ResultadoEjecucionAlgoritmos {
        -id: String
        -donacion: Donacion
        -entidadesPropuestas: List<EntidadBeneficiaria>
        -fechaYHoraEjecucion: LocalDateTime
        +getDonacion(): Donacion
        +getEntidadesPropuestas(): List<EntidadBeneficiaria>
    }
}

' -----------------------------------------
' 7. REPOSITORIOS Y SERVICIOS
' -----------------------------------------
package "Persistencia y Servicios" {
    ' --- Repositorios ---
    class RepositorioDonantes {
        -{static} RepositorioDonantes instancia
        -List<Donante> donantes
        +{static} getInstance(): RepositorioDonantes
        +agregar(donante: Donante)
        +eliminar(donante: Donante)
        +buscarTodos(): List<Donante>
        +buscarPorId(id: String): Optional<Donante>
        +buscarPorMail(mail: String): Optional<Donante>
        +existeMail(mail: String): boolean
    }

    class RepositorioEntidadesBeneficiarias {
        -{static} RepositorioEntidadesBeneficiarias instancia
        -List<EntidadBeneficiaria> entidades
        +{static} getInstance(): RepositorioEntidadesBeneficiarias
        +agregar(entidad: EntidadBeneficiaria)
        +eliminar(entidad: EntidadBeneficiaria)
        +buscarTodas(): List<EntidadBeneficiaria>
        +buscarPorId(id: String): Optional<EntidadBeneficiaria>
    }

    class RepositorioDonaciones {
        -{static} RepositorioDonaciones instancia
        -List<Donacion> donaciones
        +{static} getInstance(): RepositorioDonaciones
        +agregar(donacion: Donacion)
        +eliminar(donacion: Donacion)
        +buscarTodas(): List<Donacion>
        +buscarPorId(id: String): Optional<Donacion>
    }

    class RepositorioRegistroDonacion {
        -{static} RepositorioRegistroDonacion instancia
        -List<RegistroDonacion> registros
        +{static} getInstance(): RepositorioRegistroDonacion
        +agregarRegistro(nuevoRegistro: RegistroDonacion)
        +obtenerTodos(): List<RegistroDonacion>
        +buscarPorId(idBuscado: String): RegistroDonacion
    }

    class RepositorioResultadosAlgoritmos {
        -{static} RepositorioResultadosAlgoritmos instancia
        -List<ResultadoEjecucionAlgoritmos> resultados
        +{static} getInstance(): RepositorioResultadosAlgoritmos
        +agregar(resultado: ResultadoEjecucionAlgoritmos)
        +buscarTodos(): List<ResultadoEjecucionAlgoritmos>
        +buscarPorId(id: String): Optional<ResultadoEjecucionAlgoritmos>
        +buscarPorDonacion(idDonacion: String): List<ResultadoEjecucionAlgoritmos>
        +eliminarPorDonacion(idDonacion: String)
    }

    class RepositorioAsignacionesDonacion {
        -{static} RepositorioAsignacionesDonacion instancia
        -List<AsignacionDonacion> asignaciones
        +{static} getInstance(): RepositorioAsignacionesDonacion
        +agregar(asignacion: AsignacionDonacion)
        +eliminar(asignacion: AsignacionDonacion)
        +buscarTodas(): List<AsignacionDonacion>
        +buscarPorId(id: String): Optional<AsignacionDonacion>
        +buscarPorEntidad(idEntidad: String): List<AsignacionDonacion>
        +buscarEntreFechas(desde: LocalDate, hasta: LocalDate): List<AsignacionDonacion>
    }

    ' --- Servicios ---
    class NotificacionesService {
        -RepositorioDonantes repoDonantes
        -RepositorioRegistroDonacion repoRegistros
        -Notificador notificador
        +verificarAusenciaDonantes()
        +notificarInicioRuta(ruta: Ruta)
        +notificarEntregaExitosa(entrega: Entrega)
        +notificarEntregaNoRecibida(entrega: Entrega, motivo: String)
    }

    class MonitoreoService {
        -MonitorCamiones monitor
        -List<Camion> flota
        +registrarCamion(camion: Camion)
        +buscarCamion(patente: String): Camion
        +getFlota(): List<Camion>
        +registrarRuta(ruta: Ruta)
        +iniciarRuta(patente: String): boolean
        +recibirReporte(reporte: ReporteUbicacion): boolean
        +ubicacionActual(patente: String): UbicacionCamion
        +avanceDeRuta(patente: String): double
    }

    class RutaService {
        -MonitoreoService monitoreoService
        -RepositorioDonaciones repositorioDonaciones
        +registrarRuta(request: RutaRequest): boolean
        +iniciarRuta(patente: String): boolean
    }

    class TrazabilidadEntregaService {
        -NotificacionesService notificacionesService
        +iniciarRuta(ruta: Ruta)
        +confirmarRecepcion(entrega: Entrega, camion: Camion, fotos: List<String>)
        +marcarNoRecibida(entrega: Entrega, motivo: String)
        +registrarRetornoADeposito(entrega: Entrega, motivo: String)
    }

    class EjecucionAlgoritmosService {
        -RepositorioDonaciones repositorioDonaciones
        -RepositorioEntidadesBeneficiarias repositorioEntidades
        -RepositorioResultadosAlgoritmos repositorioResultados
        -AlgoritmoMadre algoritmoMadre
        +ejecutarAlgoritmosEnHorarioBajaCarga()
        -buscarDonacionesPendientes(): List<Donacion>
        +puedeEjecutarse(donacion: Donacion): boolean
    }
}

' -----------------------------------------
' 8. CAPA REST / API
' -----------------------------------------
package "Capa REST / API" {
    class DonanteController {
        +obtenerTodos()
        +obtenerPorId(id: String)
        +crearPersonaHumana(request: PersonaHumanaRequest)
        +crearPersonaJuridica(request: PersonaJuridicaRequest)
        +actualizarPersonaHumana(id: String, request: PersonaHumanaRequest)
        +eliminarDonante(id: String)
    }

    class EntidadBeneficiariaController {
        +obtenerTodas()
        +obtenerPorId(id: String)
        +crearEntidad(request: EntidadBeneficiariaRequest)
        +actualizarEntidad(id: String, request: EntidadBeneficiariaRequest)
    }

    class NecesidadController {
        +obtenerNecesidades(idEntidad: String)
        +registrarRecurrente(idEntidad: String, request: NecesidadRecurrenteRequest)
        +registrarExtraordinaria(idEntidad: String, request: NecesidadExtraordinariaRequest)
        +eliminarNecesidad(idEntidad: String, idNecesidad: String)
    }

    class DonacionController {
        +obtenerTodas()
        +obtenerPorId(id: String)
        +crearDonacion(request: DonacionRequest)
        +cambiarEstadoDonacion(id: String, request: CambioEstadoRequest)
    }

    class CamionController {
            -MonitoreoService servicio
            +CamionController(servicio: MonitoreoService)
            +registrarCamion(request: CamionRequest)
            +recibirUbicacion(request: ReporteUbicacionRequest)
            +ubicacionActual(patente: String)
            +avanceDeRuta(patente: String)
        }

    class RutaController {
            -RutaService rutaService
            +RutaController(rutaService: RutaService)
            +registrarRuta(request: RutaRequest)
            +iniciarRuta(patente: String)
        }

}

' =========================================
' RELACIONES ENTRE CLASES
' =========================================

' Relaciones - Catálogo y Bienes
Subcategoria --> Categoria
Bien --> Subcategoria
Bien --> Estado
Bien --> UnidadMedida
Subcategoria--> TipoAtributo

' Relaciones - Donantes
PersonaHumana --|> Donante
PersonaJuridica --|> Donante
ImportadorCSV ..> Donante : importa
ImportadorCSV --> RepositorioDonantes

Donante --> MedioContacto
Donante --> TipoDocumento
Donante --> EstadoRegistro
Donante --> TipoContactoPredeterminado
PersonaHumana --> Genero
PersonaJuridica --> TipoOrganizacion
Representante --* PersonaJuridica
MedioContacto --> TipoMedioContacto

' Relaciones - Donaciones
RegistroDonacion --> Donante
RegistroDonacion --> Bien
RegistroDonacion --> Donacion : segmenta en
Donacion --> UnidadMedida
Donacion --> Subcategoria
Donacion --> EstadoDonacion
Donacion --> RegistroCambioEstado
RegistroCambioEstado --> EstadoDonacion

' Relaciones - Patrón State en Donación
EstadoDonacionBase ..|> EstadoDonacionState
Donacion --> EstadoDonacionState : estadoActual
EstadoDonacionState ..> EstadoDonacion
EstadoDonacionFactory ..> EstadoDonacionState : crea

' Relaciones - Entidades y Necesidades
EntidadBeneficiaria *-- Representante
EntidadBeneficiaria *-- Necesidad
NecesidadRecurrente --|> Necesidad
NecesidadExtraordinaria --|> Necesidad
Necesidad --> Subcategoria
NecesidadRecurrente --> Periodicidad

' Relaciones - Notificaciones
Notificador --> TipoNotificacion : estrategias
Notificador --> TipoContactoPredeterminado
Email ..|> TipoNotificacion
SMS ..|> TipoNotificacion
WhatsApp ..|> TipoNotificacion
TipoNotificacion ..> Notificacion : genera
Notificacion --> EstadoNotificacion

' Relaciones - Logística y Entregas
Ruta "1" --> "1" Camion
Ruta "1" *-- "0..*" Entrega
Entrega --> EstadoEntrega
Entrega --> EntidadBeneficiaria : destino
Entrega --> Donacion : donacion
Entrega --> Camion : camionResponsable

Camion --> UbicacionCamion : ultimaUbicacion
MonitorCamiones --> Ruta : monitorea
MonitorCamiones ..> ReporteUbicacion : valida y procesa

' Relaciones - Repositorios
RepositorioDonantes --> Donante
RepositorioEntidadesBeneficiarias --> EntidadBeneficiaria
RepositorioDonaciones --> Donacion
RepositorioRegistroDonacion --> RegistroDonacion
RepositorioResultadosAlgoritmos --> ResultadoEjecucionAlgoritmos
RepositorioAsignacionesDonacion --> AsignacionDonacion

' Relaciones - Servicios Integrados
MonitoreoService *-- MonitorCamiones
MonitoreoService --> Camion : flota
RutaService --> MonitoreoService
RutaService --> RepositorioDonaciones

NotificacionesService --> RepositorioDonantes
NotificacionesService --> RepositorioRegistroDonacion
NotificacionesService --> Notificador

TrazabilidadEntregaService --> NotificacionesService
TrazabilidadEntregaService ..> Ruta : manipula
TrazabilidadEntregaService ..> Entrega : manipula

EjecucionAlgoritmosService --> RepositorioDonaciones
EjecucionAlgoritmosService --> RepositorioEntidadesBeneficiarias
EjecucionAlgoritmosService --> RepositorioResultadosAlgoritmos
EjecucionAlgoritmosService --> AlgoritmoMadre

' Relaciones - Controladores
DonanteController --> RepositorioDonantes
EntidadBeneficiariaController --> RepositorioEntidadesBeneficiarias
NecesidadController --> RepositorioEntidadesBeneficiarias
DonacionController --> RepositorioDonaciones
CamionController --> MonitoreoService
RutaController --> RutaService

' Relaciones - Ejecución de Algoritmos
EjecucionAlgoritmosService --> RepositorioDonaciones
EjecucionAlgoritmosService --> RepositorioEntidadesBeneficiarias
EjecucionAlgoritmosService --> RepositorioResultadosAlgoritmos
EjecucionAlgoritmosService --> AlgoritmoMadre

' Relaciones - Algoritmos de Asignación
AlgoritmoMadre --> AlgoritmoCompatibilidadSemantica
AlgoritmoMadre --> AlgoritmoPrioridadSubAtendidos
AlgoritmoMadre ..> CandidaturaBeneficiaria : evalúa

AlgoritmoCompatibilidadSemantica ..> CandidaturaBeneficiaria
AlgoritmoPrioridadSubAtendidos ..> CandidaturaBeneficiaria
AlgoritmoPrioridadSubAtendidos --> RepositorioAsignacionesDonacion

CandidaturaBeneficiaria --> Donacion
CandidaturaBeneficiaria --> EntidadBeneficiaria
CandidaturaBeneficiaria --> Necesidad

ResultadoEjecucionAlgoritmos --> Donacion
ResultadoEjecucionAlgoritmos --> EntidadBeneficiaria : propuestas
RepositorioResultadosAlgoritmos --> ResultadoEjecucionAlgoritmos

@enduml