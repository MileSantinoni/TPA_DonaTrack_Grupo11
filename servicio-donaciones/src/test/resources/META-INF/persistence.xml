<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd"
             version="2.2">

    <persistence-unit name="simple-persistence-unit" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>


        <!--        persistencia del catálogo-->
        <class>org.example.dominio.catalogo.Categoria</class>
        <class>org.example.dominio.catalogo.Subcategoria</class>
        <class>org.example.dominio.catalogo.Bien</class>
        <class>org.example.dominio.donante.Donante</class>
        <class>org.example.dominio.donante.Representante</class>
        <class>org.example.dominio.donante.PersonaHumana</class>
        <class>org.example.dominio.donante.PersonaJuridica</class>
        <class>org.example.dominio.donante.MedioContacto</class>

        <!--        persistencia de donacion-->
        <class>org.example.dominio.donacion.RegistroDonacion</class>
        <class>org.example.dominio.donacion.Donacion</class>
        <class>org.example.dominio.donacion.RegistroCambioEstado</class>

        <!--        persistencia de beneficiario-->
        <class>org.example.dominio.beneficiario.EntidadBeneficiaria</class>
        <class>org.example.dominio.beneficiario.Necesidad</class>
        <class>org.example.dominio.beneficiario.NecesidadRecurrente</class>
        <class>org.example.dominio.beneficiario.NecesidadExtraordinaria</class>
        <class>org.example.dominio.donacion.AsignacionDonacion</class>
        <class>org.example.dominio.donante.Representante</class>

        <properties>
            <!-- Conexión a HSQLDB en memoria -->
            <property name="javax.persistence.jdbc.driver" value="org.hsqldb.jdbc.JDBCDriver"/>
            <property name="javax.persistence.jdbc.url" value="jdbc:hsqldb:mem:testdb;sql.syntax_pgs=true"/>
            <property name="javax.persistence.jdbc.user" value="sa"/>
            <property name="javax.persistence.jdbc.password" value=""/>

            <!-- Configuración de Hibernate para memoria -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.HSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/> <!-- Crea las tablas al iniciar el test y las borra al terminar -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>

    <persistence-unit name="catalogo-test"
                      transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>org.example.dominio.catalogo.Categoria</class>
        <class>org.example.dominio.catalogo.Subcategoria</class>
        <class>org.example.dominio.catalogo.Bien</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="javax.persistence.jdbc.driver"
                      value="org.hsqldb.jdbc.JDBCDriver"/>
            <property name="javax.persistence.jdbc.url"
                      value="jdbc:hsqldb:mem:catalogo_test"/>
            <property name="javax.persistence.jdbc.user" value="sa"/>
            <property name="javax.persistence.jdbc.password" value=""/>

            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.HSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
        </properties>
    </persistence-unit>

    <persistence-unit name="donantes-test"
                      transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>org.example.dominio.donante.Donante</class>
        <class>org.example.dominio.donante.PersonaHumana</class>
        <class>org.example.dominio.donante.PersonaJuridica</class>
        <class>org.example.dominio.donante.MedioContacto</class>
        <class>org.example.dominio.donante.Representante</class>
        <class>org.example.dominio.beneficiario.EntidadBeneficiaria</class>
        <class>org.example.dominio.beneficiario.Necesidad</class>
        <class>org.example.dominio.beneficiario.NecesidadRecurrente</class>
        <class>org.example.dominio.beneficiario.NecesidadExtraordinaria</class>
        <class>org.example.dominio.catalogo.Categoria</class>
        <class>org.example.dominio.catalogo.Subcategoria</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="javax.persistence.jdbc.driver"
                      value="org.hsqldb.jdbc.JDBCDriver"/>
            <property name="javax.persistence.jdbc.url"
                      value="jdbc:hsqldb:mem:donantes_test"/>
            <property name="javax.persistence.jdbc.user" value="sa"/>
            <property name="javax.persistence.jdbc.password" value=""/>

            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.HSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
        </properties>
    </persistence-unit>

    <persistence-unit name="donaciones-test" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>org.example.dominio.donante.Donante</class>
        <class>org.example.dominio.donante.PersonaHumana</class>
        <class>org.example.dominio.donante.PersonaJuridica</class>
        <class>org.example.dominio.donante.MedioContacto</class>
        <class>org.example.dominio.donante.Representante</class>

        <class>org.example.dominio.catalogo.Categoria</class>
        <class>org.example.dominio.catalogo.Subcategoria</class>

        <class>org.example.dominio.donacion.Donacion</class>
        <class>org.example.dominio.donacion.RegistroCambioEstado</class>

        <class>org.example.dominio.catalogo.Bien</class>
        <class>org.example.dominio.donacion.RegistroDonacion</class>

        <class>org.example.dominio.beneficiario.EntidadBeneficiaria</class>
        <class>org.example.dominio.beneficiario.Necesidad</class>
        <class>org.example.dominio.beneficiario.NecesidadRecurrente</class>
        <class>org.example.dominio.beneficiario.NecesidadExtraordinaria</class>
        <class>org.example.dominio.donacion.AsignacionDonacion</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="javax.persistence.jdbc.driver"
                      value="org.hsqldb.jdbc.JDBCDriver"/>
            <property name="javax.persistence.jdbc.url"
                      value="jdbc:hsqldb:mem:donaciones_test"/>
            <property name="javax.persistence.jdbc.user" value="sa"/>
            <property name="javax.persistence.jdbc.password" value=""/>

            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.HSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.show_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>