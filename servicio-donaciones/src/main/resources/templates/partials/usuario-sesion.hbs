{{#if sesion.autenticado}}
    <span class="avatar-initials dt-avatar">{{sesion.inicial}}</span>
    <span class="dt-nombre" title="{{sesion.nombre}}">
        {{sesion.nombre}}
    </span>

    <form class="dt-salida" method="post" action="/auth/logout">
        <input type="hidden" name="csrf" value="{{sesion.csrf}}">

        <button class="dt-salir"
                type="submit"
                aria-label="Cerrar sesión"
                title="Cerrar sesión">
            <svg width="20" height="20" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round"
                 aria-hidden="true">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <path d="M16 17l5-5-5-5M21 12H9"/>
            </svg>
        </button>
    </form>
{{/if}}