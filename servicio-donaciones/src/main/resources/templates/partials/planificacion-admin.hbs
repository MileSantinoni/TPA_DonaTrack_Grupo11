<dialog id="plan-modal" aria-labelledby="plan-titulo">
  <header>
    <h2 id="plan-titulo">Planificar la entrega</h2>

    <button type="button"
            class="ac-cerrar"
            data-plan-cerrar
            aria-label="Cerrar">×</button>
  </header>

  <p>
    La entidad ya está asignada. Confirmá los datos de la carga
    para obtener el camión y la ruta.
  </p>

  <p id="plan-deposito" class="ac-ayuda"></p>

  <form id="plan-form">
    <div id="plan-lista" class="plan-lista"></div>

    <p class="ac-ayuda">
      El planificador utiliza la dirección confirmada de la entidad
      y los camiones disponibles.
      La entrega se programa para mañana.
    </p>

    <p id="plan-error" class="ac-error" role="alert"></p>

    <div class="plan-acciones">
      <button type="button"
              class="btn btn-secondary"
              data-plan-cerrar>
        Continuar más tarde
      </button>

      <button id="plan-submit"
              type="submit"
              class="btn btn-primary-action">
        Confirmar planificación
      </button>
    </div>
  </form>

  <section id="plan-resultado" hidden aria-live="polite">
    <div id="plan-resumen"></div>

    <div class="plan-acciones">
      <button type="button"
              class="btn btn-secondary"
              data-plan-cerrar>
        Cerrar
      </button>

      <a id="plan-ver-camion"
         class="btn btn-primary-action"
         href="/administracion/camiones">
        Ver camión e iniciar traslado
      </a>
    </div>
  </section>
</dialog>

<dialog id="inicio-ruta-modal"
        aria-labelledby="inicio-ruta-titulo">
  <header>
    <h2 id="inicio-ruta-titulo">Iniciar traslado</h2>

    <button type="button"
            class="ac-cerrar"
            data-inicio-cerrar
            aria-label="Cerrar">×</button>
  </header>

  <p id="inicio-ruta-texto"></p>

  <p>
    Confirmá cuando el camión salga del depósito.
    Las donaciones pasarán a En traslado.
  </p>

  <p id="inicio-ruta-error"
     class="ac-error"
     role="alert"></p>

  <div class="plan-acciones">
    <button type="button"
            class="btn btn-secondary"
            data-inicio-cerrar>
      Cancelar
    </button>

    <button type="button"
            id="inicio-ruta-confirmar"
            class="btn btn-primary-action">
      Iniciar traslado
    </button>
  </div>
</dialog>