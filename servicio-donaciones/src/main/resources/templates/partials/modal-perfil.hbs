<dialog id="modal-perfil"
        class="dt-perfil-modal"
        aria-labelledby="perfil-titulo">

    <header class="dt-perfil-cabecera">
        <div>
            <span class="dt-cuenta-etiqueta">
                BIENVENIDO A DONATRACK
            </span>

            <h2 id="perfil-titulo">
                {{#if entidad}}
                    Completá el registro de tu entidad
                {{else}}
                    Completá tu registro de donante
                {{/if}}
            </h2>

            <p>
                Tu cuenta ya está creada.
                Completá estos datos para continuar.
            </p>
        </div>
    </header>

    <div class="dt-perfil-contenido">
        {{#if error}}
            <p class="dt-cuenta-error" role="alert">
                {{error}}
            </p>
        {{/if}}

        {{#unless bloqueado}}
            <form id="form-completar-perfil"
                  method="post"
                  action="/cuenta/completar"
                  class="dt-cuenta-form">

                <input type="hidden"
                       name="csrf"
                       value="{{sesion.csrf}}">

                {{#if entidad}}
                    <label>
                        Razón social
                        <input name="razonSocial"
                               maxlength="180"
                               autocomplete="organization"
                               required>
                    </label>

                    <label>
                        Teléfono
                        <input name="telefono"
                               type="tel"
                               maxlength="40"
                               autocomplete="tel"
                               required>
                    </label>

                    <p class="dt-cuenta-ayuda">
                        Después de registrarte, configurá la dirección donde recibirás
                        las donaciones desde tu panel.
                    </p>

                {{else}}
                    <label>
                        Tipo de persona
                        <select name="persona" id="cuenta-persona">
                            <option value="humana">Persona humana</option>
                            <option value="juridica">Persona jurídica</option>
                        </select>
                    </label>

                    <fieldset data-persona="humana">
                        <legend>Datos personales</legend>

                        <label>
                            Nombre
                            <input name="nombre"
                                   maxlength="80"
                                   autocomplete="given-name"
                                   required>
                        </label>

                        <label>
                            Apellido
                            <input name="apellido"
                                   maxlength="80"
                                   autocomplete="family-name"
                                   required>
                        </label>

                        <label>
                            Edad
                            <input name="edad"
                                   type="number"
                                   min="0"
                                   max="120"
                                   step="1"
                                   required>
                        </label>

                        <label>
                            Género
                            <select name="genero">
                                <option value="OTRO">
                                    Otro / Prefiero no indicar
                                </option>
                                <option value="FEMENINO">Femenino</option>
                                <option value="MASCULINO">Masculino</option>
                            </select>
                        </label>

                        <label class="dt-cuenta-ancho">
                            Dirección
                            <input name="direccion"
                                   maxlength="180"
                                   autocomplete="street-address"
                                   required>
                        </label>
                    </fieldset>

                    <fieldset data-persona="juridica" hidden disabled>
                        <legend>Datos de la organización</legend>

                        <label class="dt-cuenta-ancho">
                            Razón social
                            <input name="razonSocial"
                                   maxlength="180"
                                   required>
                        </label>

                        <label>
                            Tipo de organización
                            <select name="organizacion">
                                <option value="EMPRESA">Empresa</option>
                                <option value="ONG">ONG</option>
                                <option value="INSTITUCION">Institución</option>
                                <option value="GUBERNAMENTAL">Gubernamental</option>
                            </select>
                        </label>

                        <label>
                            Rubro
                            <input name="rubro"
                                   maxlength="180"
                                   required>
                        </label>
                    </fieldset>

                    <label>
                        DNI / CUIT
                        <input name="documento"
                               maxlength="30"
                               required>
                    </label>
                {{/if}}

                <p class="dt-cuenta-ayuda">
                    Usaremos el correo verificado de tu cuenta de Logto.
                </p>
            </form>
        {{/unless}}

        <div class="dt-perfil-acciones"
             style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;width:100%;margin-top:20px;">

            <form method="post"
                  action="/auth/logout"
                  style="margin:0;flex:0 0 auto;width:auto;">

                <input type="hidden"
                       name="csrf"
                       value="{{sesion.csrf}}">

                <button type="submit" class="btn btn-secondary">
                    Cerrar sesión
                </button>
            </form>

            {{#unless bloqueado}}
                <button type="submit"
                        form="form-completar-perfil"
                        class="btn btn-primary-action">
                    Guardar y comenzar
                </button>
            {{/unless}}
        </div>
    </div>
</dialog>

<noscript>
    Activá JavaScript para completar el registro.
    Tu perfil seguirá pendiente.
</noscript>