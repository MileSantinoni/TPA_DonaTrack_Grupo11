<dialog id="modal-perfil"
        class="dt-perfil-modal"
        aria-labelledby="perfil-titulo">

    <header class="dt-perfil-cabecera">
        <div>
            <span class="dt-cuenta-etiqueta">
                BIENVENIDO A DONATRACK
            </span>

            <h2 id="perfil-titulo">
                {{#if entidad}}
                    Completá el registro de tu entidad
                {{else}}
                    Completá tu registro de donante
                {{/if}}
            </h2>

            <p>
                Tu cuenta ya está creada.
                Completá estos datos para continuar.
            </p>
        </div>
    </header>

    <div class="dt-perfil-contenido">
        {{#if error}}
            <p class="dt-cuenta-error" role="alert">
                {{error}}
            </p>
        {{/if}}

        {{#unless bloqueado}}
            <form id="form-completar-perfil"
                  method="post"
                  action="/cuenta/completar"
                  class="dt-cuenta-form">

                <input type="hidden"
                       name="csrf"
                       value="{{sesion.csrf}}">

                {{> templates/partials/perfil-campos}}
            </form>
        {{/unless}}

        <div class="dt-perfil-acciones"
             style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;width:100%;margin-top:20px;">

            <form method="post"
                  action="/auth/logout"
                  style="margin:0;flex:0 0 auto;width:auto;">

                <input type="hidden"
                       name="csrf"
                       value="{{sesion.csrf}}">

                <button type="submit" class="btn btn-secondary">
                    Cerrar sesión
                </button>
            </form>

            {{#unless bloqueado}}
                <button type="submit"
                        form="form-completar-perfil"
                        class="btn btn-primary-action">
                    Guardar y comenzar
                </button>
            {{/unless}}
        </div>
    </div>
</dialog>

<noscript>
    Activá JavaScript para completar el registro.
    Tu perfil seguirá pendiente.
</noscript>