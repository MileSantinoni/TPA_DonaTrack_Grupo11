<header class="navbar dt-header">
    <div class="navbar-inner">
        <div class="brand-logo">
            <img src="/assets/images/logo_principal.svg"
                 alt="DonaTrack Logo"
                 width="173"
                 height="54">
        </div>

        <nav class="nav-links">
            <a href="/#mapa" class="nav-link">
                Mapa de entregas
            </a>

            <a href="/#sobre-nosotros" class="nav-link">
                Sobre DonaTrack
            </a>

            {{#if sesion.autenticado}}
                {{#if sesion.perfilAvisos}}
                    <div class="dt-avisos"
                         data-perfil="{{sesion.perfilAvisos}}">
                        {{> templates/partials/notificaciones}}
                    </div>
                {{/if}}

                {{> templates/partials/usuario-sesion}}
            {{else}}
                <a href="/login" class="nav-link">
                    Iniciar sesión
                </a>

                <a href="/auth/registro?tipo=DONANTE"
                   class="btn btn-sm btn-primary-action">
                    Quiero donar
                </a>

                <a href="/auth/registro?tipo=ENTIDAD"
                   class="btn btn-sm btn-secondary">
                    Registrar mi entidad
                </a>
            {{/if}}
        </nav>
    </div>
</header>