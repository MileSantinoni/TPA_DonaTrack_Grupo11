<header class="navbar">
        <div class="navbar-inner">
            <div class="brand-logo">
                <img src="/assets/images/logo_principal.svg" alt="DonaTrack Logo" width="173" height="54" />
            </div>
            <nav class="nav-links">
                <a href="/#mapa" class="nav-link">Mapa de entregas</a>
                <a href="/#sobre-nosotros" class="nav-link">Sobre DonaTrack</a>
                {{#if sesion.autenticado}}
                    {{> templates/partials/usuario-sesion}}
                {{else}}
                    <a href="/login" class="nav-link">Iniciar sesión</a>
                    <a href="/auth/registro" class="btn btn-sm btn-primary-action">
                        Registrarme
                    </a>
                {{/if}}
            </nav>
        </div>
    </header>
