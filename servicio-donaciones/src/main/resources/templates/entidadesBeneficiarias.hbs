<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Entidades beneficiarias | DonaTrack</title>

    <link rel="stylesheet" href="/assets/main.css">
    <link rel="stylesheet" href="/assets/css/mis-donaciones.css">
    <link rel="stylesheet" href="/assets/css/entidades-beneficiarias.css">
    <link rel="stylesheet" href="/assets/css/marco-compartido.css">
    <link rel="stylesheet" href="/assets/css/footer-panel.css">

    <script src="/assets/js/entidades-beneficiarias.js" defer></script>
</head>

<body class="dt-donante dt-entidades dt-fondo">
<div class="dt-pagina dt-marco">

    {{> templates/partials/header-donante}}

    <main class="dt-contenido">
        <section class="dt-presentacion" aria-labelledby="titulo">
            <p class="dt-eyebrow">MI ESPACIO DONANTE</p>

            <h1 id="titulo" class="font-manrope">
                Cada donación cuenta.
            </h1>

            <p class="dt-intro">
                Consultá tus donaciones y conocé las necesidades
                de las entidades beneficiarias.
            </p>
        </section>

        <nav class="dt-tabs" aria-label="Mi espacio donante">
            <a class="dt-tab" href="/mis-donaciones">
                Mis donaciones
            </a>

            <a class="dt-tab dt-tab-activa"
               href="/entidades-beneficiarias"
               aria-current="page">
                Entidades beneficiarias
            </a>
        </nav>

        <form id="dt-buscar-entidades"
              class="dt-buscar-entidades"
              action="/entidades-beneficiarias"
              method="get"
              role="search">

            <label class="dt-buscador">
                <img src="/assets/images/donante/buscar.svg" alt="">

                <span class="dt-sr-only">
                    Buscar entidad por nombre
                </span>

                <input type="search"
                       name="nombre"
                       value="{{nombre}}"
                       placeholder="Buscar entidad por nombre…"
                       autocomplete="off">
            </label>

            <button class="btn btn-primary-action" type="submit">
                Buscar
            </button>
        </form>

        {{#if nombre}}
            <a class="dt-limpiar-busqueda" href="/entidades-beneficiarias">
                Limpiar búsqueda
            </a>
        {{/if}}

        <section class="dt-entidades-seccion"
                 aria-labelledby="titulo-entidades">

            <h2 id="titulo-entidades" class="font-manrope">
                Entidades beneficiarias
            </h2>

            <p class="dt-entidades-descripcion">
                Conocé qué necesitan. Las asignaciones se realizan
                desde el depósito.
            </p>

            <p class="dt-entidades-descripcion">
                Resultados: {{total}}
            </p>

            <div class="dt-entidades-grid">
                {{#each entidades}}
                    <article class="dt-entidad-card">
                        <h3>
                            <img src="/assets/images/donante/entidad.svg" alt="">
                            {{nombre}}
                        </h3>

                        <p>{{direccion}}</p>

                        <p class="dt-entidad-resumen">
                            Necesidades registradas: {{cantidadNecesidades}}
                        </p>

                        <button class="btn dt-entidad-boton"
                                type="button"
                                data-modal="necesidades-{{id}}"
                                aria-haspopup="dialog"
                                aria-controls="necesidades-{{id}}">
                            Ver necesidades
                            <span class="dt-sr-only">de {{nombre}}</span>
                        </button>
                    </article>
                {{else}}
                    <p class="dt-vacio dt-entidades-sin-resultados">
                        No encontramos entidades con esa búsqueda.
                    </p>
                {{/each}}
            </div>
        </section>

        {{#if hayPaginacion}}
            <form action="/entidades-beneficiarias"
                  method="get"
                  class="dt-paginacion"
                  aria-label="Paginación de entidades">

                <input type="hidden" name="nombre" value="{{nombre}}">

                {{#if anterior}}
                    <button class="btn btn-secondary"
                            type="submit"
                            name="pagina"
                            value="{{anterior}}">
                        Anterior
                    </button>
                {{/if}}

                <span>Página {{pagina}} de {{paginas}}</span>

                {{#if siguiente}}
                    <button class="btn btn-secondary"
                            type="submit"
                            name="pagina"
                            value="{{siguiente}}">
                        Siguiente
                    </button>
                {{/if}}
            </form>
        {{/if}}
    </main>

    {{> templates/partials/footer-panel}}

</div>

{{#each entidades}}
    <dialog id="necesidades-{{id}}"
            class="dt-modal-necesidades"
            aria-labelledby="titulo-necesidades-{{id}}">

        <h2 id="titulo-necesidades-{{id}}">
            Necesidades de {{nombre}}
        </h2>

        <p class="dt-modal-direccion">{{direccion}}</p>

        <ul class="dt-necesidades-lista">
            {{#each necesidades}}
                <li class="dt-necesidad">
                    <h3>{{descripcion}}</h3>

                    <p class="dt-necesidad-categoria">
                        {{categoria}} / {{subcategoria}}
                    </p>

                    <span class="dt-necesidad-tipo">
                        {{tipo}}
                        {{#if periodicidad}}
                            · {{periodicidad}}
                        {{/if}}
                    </span>

                    <div class="dt-necesidad-cantidad">
                        <p>Objetivo: {{objetivo}}</p>
                        <p>Cubierta: {{cubierta}}</p>

                        {{#if satisfecha}}
                            <span class="badge dt-badge-entregada">
                                Cubierta
                            </span>
                        {{else}}
                            <p>Pendiente: {{pendiente}}</p>
                        {{/if}}
                    </div>
                </li>
            {{else}}
                <li class="dt-vacio">
                    Esta entidad todavía no registró necesidades.
                </li>
            {{/each}}
        </ul>

        <div class="dt-modal-pie">
            <p>Las asignaciones se realizan desde el depósito.</p>

            <form method="dialog">
                <button class="btn btn-secondary"
                        type="submit"
                        autofocus>
                    Cerrar
                </button>
            </form>
        </div>
    </dialog>
{{/each}}

</body>
</html>