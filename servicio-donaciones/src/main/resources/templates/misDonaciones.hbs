<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="google-maps-key" content="{{googleMapsKey}}">
    <script defer src="/assets/js/seguimiento-donacion.js"></script>

    <title>Mis donaciones | DonaTrack</title>

    <link rel="stylesheet" href="/assets/main.css">
    <link rel="stylesheet" href="/assets/css/mis-donaciones.css">
    <link rel="stylesheet" href="/assets/css/marco-compartido.css">
    <link rel="stylesheet" href="/assets/css/footer-panel.css">

    <script defer src="/assets/js/mis-donaciones.js"></script>
</head>

<body class="dt-donante dt-fondo">
<div class="dt-pagina dt-marco">

    {{> templates/partials/header-donante}}

    <main class="dt-contenido">
        <section class="dt-presentacion" aria-labelledby="titulo">
            <p class="dt-eyebrow">MI ESPACIO DONANTE</p>

            <h1 id="titulo" class="font-manrope">
                Cada donación cuenta.
            </h1>

            <p class="dt-intro">
                Consultá tus donaciones y conocé las necesidades
                de las entidades beneficiarias.
            </p>
        </section>

        <nav class="dt-tabs" aria-label="Mi espacio donante">
            <a href="/mis-donaciones"
               class="dt-tab dt-tab-activa"
               aria-current="page">
                Mis donaciones
            </a>

            <a href="/entidades-beneficiarias" class="dt-tab">
                Entidades beneficiarias
            </a>
        </nav>

        <form class="dt-filtros"
              id="dt-filtros"
              action="/mis-donaciones"
              method="get">

            <label>
                Estado
                <select name="estado">
                    <option value="">Todos los estados</option>
                    {{#each estados}}
                        <option value="{{valor}}" {{#if elegido}}selected{{/if}}>
                            {{nombre}}
                        </option>
                    {{/each}}
                </select>
                <small>Opcional</small>
            </label>

            <label>
                Categoría
                <select name="categoria">
                    <option value="">Todas las categorías</option>
                    {{#each categorias}}
                        <option value="{{nombre}}" {{#if elegido}}selected{{/if}}>
                            {{nombre}}
                        </option>
                    {{/each}}
                </select>
                <small>Opcional</small>
            </label>

            <label>
                Subcategoría
                <select name="subcategoria">
                    <option value="">Todas las subcategorías</option>
                    {{#each subcategorias}}
                        <option value="{{nombre}}" {{#if elegido}}selected{{/if}}>
                            {{nombre}}
                        </option>
                    {{/each}}
                </select>
                <small>Opcional</small>
            </label>

            <button type="submit" class="btn btn-primary-action">
                Buscar
            </button>

            <a href="/mis-donaciones"
               class="btn btn-secondary dt-limpiar">
                Limpiar filtros
            </a>
        </form>

        <div class="dt-resultados">
            <h2>Tus donaciones</h2>
            <p>{{total}} donaciones</p>
        </div>

        <div class="dt-lista">
            {{#each donaciones}}
                <details class="dt-donacion">
                    <summary>
                        <span class="dt-id">{{id}}</span>

                        <span class="dt-toggle">
                            <span class="dt-ver">Mostrar detalles</span>
                            <span class="dt-ocultar">Ocultar detalles</span>
                        </span>

                        <h3>{{descripcion}}</h3>

                        <p>
                            {{cantidad}} {{unidad}}
                            · {{categoria}} / {{subcategoria}}
                            · {{fecha}}
                        </p>

                        <span class="badge {{claseEstado}}">
                            {{estado}}
                        </span>
                    </summary>

                    <div class="dt-detalle-simple">
                        <section class="dt-seguimiento-real"
                                 data-seguimiento-id="{{id}}"
                                 aria-label="Seguimiento de la entrega">

                            <div class="dt-seguimiento-cabecera">
                                <h4>Seguimiento de la entrega</h4>

                                <button type="button"
                                        class="btn btn-secondary dt-actualizar-mapa">
                                    Actualizar ubicación
                                </button>
                            </div>

                            <p class="dt-seguimiento-mensaje" role="status">
                                Abrí los detalles para consultar el seguimiento.
                            </p>

                            <div class="dt-google-mapa"
                                 aria-label="Mapa de la entrega"
                                 hidden></div>

                            <p class="dt-mapa-leyenda" hidden>
                                <span>🟠 Depósito</span>
                                <span>🟢 Destino</span>
                                <span>🔵 Último reporte del camión</span>
                            </p>

                            <p class="dt-seguimiento-fecha"></p>
                        </section>
                        <h4>Entidades asociadas</h4>

                        {{#each entidades}}
                            <p>{{this}}</p>
                        {{else}}
                            <p>Sin entidad asignada.</p>
                        {{/each}}

                        <h4 class="dt-historial-titulo">
                            Historial de la donación
                        </h4>

                        <ol class="dt-historial-real">
                            {{#each historial}}
                                <li>
                                    <strong>{{estado}}</strong>
                                    <span class="dt-fecha">{{fecha}}</span>

                                    {{#if motivo}}
                                        <p>{{motivo}}</p>
                                    {{/if}}
                                </li>
                            {{else}}
                                <li>Sin cambios registrados.</li>
                            {{/each}}
                        </ol>
                    </div>
                </details>
            {{else}}
                <div class="dt-vacio">
                    No hay donaciones que coincidan con esta búsqueda.
                </div>
            {{/each}}
        </div>

        {{#if hayPaginacion}}
            <form action="/mis-donaciones"
                  method="get"
                  class="dt-paginacion"
                  aria-label="Paginación de donaciones">

                <input type="hidden" name="estado" value="{{estado}}">
                <input type="hidden" name="categoria" value="{{categoria}}">
                <input type="hidden" name="subcategoria" value="{{subcategoria}}">

                {{#if anterior}}
                    <button type="submit"
                            name="pagina"
                            value="{{anterior}}"
                            class="btn btn-secondary">
                        Anterior
                    </button>
                {{/if}}

                <span>Página {{pagina}} de {{paginas}}</span>

                {{#if siguiente}}
                    <button type="submit"
                            name="pagina"
                            value="{{siguiente}}"
                            class="btn btn-secondary">
                        Siguiente
                    </button>
                {{/if}}
            </form>
        {{/if}}
    </main>

    {{> templates/partials/footer-panel}}

</div>
</body>
</html>